{
    "name": "call-calendar-api-spec",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsp compile .",
        "watch": "tsp compile . --watch",
        "smoke": "tsp compile . --no-emit && node scripts/smoke.mjs",
        "check:fresh": "tsp compile . && git diff --exit-code api/openapi/openapi.yaml"
    },
    "devDependencies": {
        "@typespec/compiler": "^0.66",
        "@typespec/http": "^0.66",
        "@typespec/openapi3": "^0.66",
        "@typespec/rest": "^0.66",
        "js-yaml": "^4.1.0"
    }
}
